# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# LAS ÚNICAS 2 VARIABLES DEL PROYECTO:
# ==========================================

# 1. ID de la carpeta pública de Google Drive (donde están las fotos)
VITE_DRIVE_FOLDER_ID=""

# 2. URL de la Web App de Google Apps Script (que sincroniza los votos con tu Drive)
VITE_SYNC_API_URL=""
